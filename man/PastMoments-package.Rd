\name{PastMoments-package}
\alias{PastMoments}
\alias{PastMoments-package}
\docType{package}
\title{Reconstruction of Empirical Trait Moments through Phylogenetic Time}
\description{
\pkg{PastMoments} reconstructs conditional empirical means, variances, and
expected empirical standard deviations of continuous traits along rooted
phylogenetic trees under Brownian models.
}
\details{
The package provides clade-specific reconstructions, analytic expectations and
variances, optional quantiles of Gaussian quadratic forms, and graphical
summaries. Time is measured from the original root of the supplied tree.
}
\author{Gilles Didier}
\references{
Didier, G. (draft). \emph{Phylogenetic reconstruction of trait summary
statistics and disparity dynamics}.
}
